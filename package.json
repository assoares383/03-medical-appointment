{
  "name": "medical-appointment-assistant",
  "version": "1.0.0",
  "description": "Assistente de consultas médicas com LangGraph, LangChain e Fastify",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env src/index.ts",
    "dev": "node --watch --inspect --env-file .env src/index.ts",
    "test": "node --env-file .env --test tests/**/*.test.ts",
    "test:dev": "node --inspect --env-file .env --test --watch tests/**/*.test.ts",
    "test:unit:dev": "node --inspect --test --watch tests/**/*unit.test.ts",
    "test:unit": "node --inspect --test tests/**/*unit.test.ts",
    "test:e2e:dev": "node --inspect --env-file .env --test --watch tests/**/*e2e.test.ts",
    "test:e2e": "node --inspect --env-file .env --test tests/**/*e2e.test.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev",
    "type-check": "tsc --noEmit",
    "security:snyk": "npx --yes snyk test",
    "security:snyk:monitor": "npx --yes snyk monitor",
    "sonar": "npx --yes sonar-scanner",
    "code-review": "node scripts/code-review.mjs"
  },
  "keywords": [
    "langchain",
    "prompt-chaining",
    "medical-appointments",
    "openrouter",
    "ollama"
  ],
  "author": "assoares383",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.7.4",
    "@langchain/openai": "^1.2.5",
    "@openrouter/sdk": "^0.5.1",
    "fastify": "^5.12.8",
    "langchain": "^1.6.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.7.2",
    "@types/node": "^24.10.12"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "@fastify/ajv-compiler": {
      "fast-uri": "^3.1.9"
    },
    "fast-json-stringify": {
      "fast-uri": "^3.1.9"
    }
  }
}
